# ==============================================================================
# Common Git Ignore - Backend & Frontend (PurplePulse)
# ==============================================================================

# Dependencies (Root, Backend & Frontend)
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Environment & Secret files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Build outputs & caches
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/
.vite/
frontend/.vite/
.vercel/
frontend/.vercel/

# Package manager locks & logs
pnpm-lock.yaml
package-lock.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & coverage output
coverage/
.nyc_output/

# Debug / scratch / temporary files
*.txt
backend/list_users.js
backend/verify_*.js
frontend/verify_*.js

# IDE, Editor & OS artifacts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
